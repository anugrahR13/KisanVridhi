# Database Connection URL (PostgreSQL default, SQLite fallback)
DATABASE_URL=sqlite:///./sustainable_farming.db
# For PostgreSQL: DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/sustainable_farming

# Security & JWT Token Key
JWT_SECRET=supersecretkeyforsustainablefarmingplatform2026_btech_project
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# File Upload Settings
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE=5242880

# Optional AI API Key (For LLM connection upgrade)
AI_API_KEY=

# Server Configuration
FRONTEND_URL=http://localhost:5173
PORT=8000
